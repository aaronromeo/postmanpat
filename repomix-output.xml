#!/bin/sh
set -eu

if [ -z "${POSTMANPAT_RULES_CONFIG:-}" ]; then
  echo "POSTMANPAT_RULES_CONFIG is required" >&2
  exit 1
fi

cat >/etc/cron.d/postmanpat <<EOF
