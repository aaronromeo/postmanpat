func TestMatchesClientListIDRegex(t *testing.T) {
	matchers := &appconfig.ClientMatchers{
		ListIDRegex: []string{`<f7443300a7bb349db1e85fa6e\.1520313\.list-id\.mcsv\.net>`},
	}
