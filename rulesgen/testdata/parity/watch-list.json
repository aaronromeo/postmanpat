{
  "kind": "rule",
  "lens": "list_lens",
  "lane": "watch",
  "cluster": {
    "cluster_id": "list-updates",
    "count": 5,
    "latest_date": "2026-09-01T10:00:00Z",
    "keys": {"ListID": "updates.example.com"},
